# Copy to backend/.env and fill in the two required values.
# Read by backend/src/env.ts (and CLERK_SECRET_KEY by backend/src/owner.ts).

# --- Required -----------------------------------------------------------------

# OpenAI key with access to the Realtime API (voice) and chat completions (summaries).
OPENAI_API_KEY=sk-your-key-here

# Postgres connection string (Neon or any Postgres). Create the tables once with:
#   npm run prisma:push --workspace=backend
DATABASE_URL=postgresql://user:password@host:5432/christopher?sslmode=require

# --- Optional (defaults shown) --------------------------------------------------

# Port the API listens on.
PORT=8787

# Allowed browser origins, comma-separated. In development any localhost port is
# also allowed, so this only matters for deployed frontends.
FRONTEND_ORIGIN=http://localhost:3000

# Voice model and voice for the live conversation.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

# Model that writes end-of-session summaries and translates learned words.
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Audio model used by the /pronounce route (not called by the current frontend).
OPENAI_PRONUNCIATION_MODEL=gpt-audio-mini

# Free-trial gate per owner: number of conversations, and seconds per conversation.
FREE_SESSIONS=1
FREE_SECONDS=60
# Connections where Christopher never hears the learner (silent or broken mic)
# that are free; the next connection uses the trial.
FREE_UNHEARD_CONNECTS=4

# Owner ids that skip the trial gate, comma-separated,
# e.g. clerk:user_abc123,guest:3f2c9a4e-...
UNLIMITED_OWNERS=

# Clerk secret key. Leave empty to run guest-only.
CLERK_SECRET_KEY=

# Clerk JWT public key (Clerk dashboard > API keys > JWT public key, PEM).
# Optional: lets the API check sign-ins offline instead of fetching Clerk's keys
# every few minutes.
CLERK_JWT_KEY=
