# Copy to frontend/.env.local. Every value is optional for local development.

# Where the backend API runs. Defaults to http://localhost:8787 when unset
# (frontend/lib/api.ts).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# Clerk keys. Leave both empty to run guest-only; set both to enable sign-in.
# The publishable key shows the sign-in buttons (frontend/lib/auth.ts);
# the secret key turns on Clerk's middleware (frontend/middleware.ts).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
